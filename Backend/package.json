{
  "name": "@vocessilentes/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "academic:prepare": "node scripts/prepare-module-ii-sql.js",
    "academic:demo": "node scripts/academic-demo.js",
    "academic:verify": "node scripts/academic-review.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/check-syntax.js && pnpm db:generate",
    "db:validate": "prisma validate",
    "db:generate": "node scripts/generate-client.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:inspect": "node scripts/inspect-database.js",
    "db:test": "node --test --test-concurrency=1 tests/database/*.test.js tests/auth/*.test.js",
    "db:check": "node scripts/check-database.js",
    "evidence:configure": "node scripts/evidence-maintenance.js configure",
    "evidence:check": "node scripts/evidence-maintenance.js check",
    "evidence:cleanup": "node scripts/evidence-maintenance.js cleanup",
    "evidence:probe": "node scripts/probe-evidence-s3.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.9.11",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csrf-csrf": "4.0.3",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "esbuild": "0.25.12",
    "prisma": "7.10.0",
    "supertest": "7.3.1"
  }
}
