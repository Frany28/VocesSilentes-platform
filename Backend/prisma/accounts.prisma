enum UserRole {
  USER
  ADMIN

  @@schema("vocessilentes")
}

enum IdentityProvider {
  GOOGLE
  MICROSOFT

  @@schema("vocessilentes")
}

model User {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName           String             @db.VarChar(100)
  lastName            String?            @db.VarChar(100)
  email               String             @unique @db.VarChar(254)
  username            String             @unique @db.VarChar(50)
  passwordHash        String             @db.VarChar(255)
  profileImagePath    String?
  role                UserRole           @default(USER)
  isActive            Boolean            @default(true)
  emailVerified       Boolean            @default(false)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?          @db.Timestamptz(3)
  isDeleted           Boolean            @default(false)
  deletedAt           DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  identities          ExternalIdentity[]
  sessions            Session[]
  lessonProgress      LessonProgress[]
  exerciseProgress    ExerciseProgress[]
  reports             Report[]           @relation("ReportAuthor")
  resolvedReports     Report[]           @relation("ReportResolver")

  @@schema("vocessilentes")
}

model ExternalIdentity {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  providerUserId String           @db.VarChar(255)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@schema("vocessilentes")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@schema("vocessilentes")
}
