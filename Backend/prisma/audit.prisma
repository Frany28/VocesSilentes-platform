enum AuditOperation {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_REGISTERED
  REPORT_CREATED
  REPORT_RESOLVED
  REPORT_REOPENED
  REPORT_EVIDENCE_ATTACHED
  LESSON_PROGRESS_UPDATED
  EXERCISE_PROGRESS_UPDATED

  @@schema("vocessilentes")
}

model AuditLog {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?        @db.Uuid
  operation  AuditOperation
  entityType String         @default("User") @db.VarChar(50)
  entityId   String         @db.Uuid
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([entityId, createdAt])
  @@schema("vocessilentes")
}
