# Variables privadas: nunca usar el prefijo VITE_ ni publicarlas en el frontend.
NODE_ENV=development
HOST=localhost
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
# Vacío permite arrancar la base HTTP sin PostgreSQL.
DATABASE_URL=
# El cliente fuerza TLS con certificado verificado para hosts Supabase (sslmode=verify-full).
# Migraciones: conexión directa o Session (5432 en Supabase), nunca Transaction (6543).
DIRECT_URL=
# Storage S3 del MISMO proyecto Supabase; exclusivas del backend. Nunca VITE_*.
S3_ENDPOINT=
S3_REGION=
s3_access_key_id=
s3_secret_access_key=
# Opcional para migrate dev: base INDEPENDIENTE y descartable, nunca la base destino.
SHADOW_DATABASE_URL=
# Auth: secreto privado de 64 hex obligatorio en production; vacío genera uno por proceso en desarrollo.
CSRF_SECRET=
# Duración absoluta de sesión: 24 horas; máximo 7 días.
SESSION_DURATION_SECONDS=86400
SESSION_SAME_SITE=lax
# Ventana fija: 10 minutos. Identificador significa IP + correo normalizado.
AUTH_RATE_WINDOW_SECONDS=600
LOGIN_IP_LIMIT=30
LOGIN_IDENTIFIER_LIMIT=5
REGISTER_IP_LIMIT=5
REGISTER_IDENTIFIER_LIMIT=3
# Solo IP literales de proxies conocidos; vacío no confía en X-Forwarded-*.
TRUST_PROXY_IPS=
# Bucket general existente; reportes siempre usan report-evidence, independientemente de este valor.
S3_BUCKET_NAME=
