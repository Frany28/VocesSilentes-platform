# Variables privadas: nunca usar el prefijo VITE_ ni publicarlas en el frontend.
NODE_ENV=development
HOST=localhost
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
# Vacío permite arrancar la base HTTP sin PostgreSQL.
DATABASE_URL=
# Migraciones: conexión directa o Session (5432 en Supabase), nunca Transaction (6543).
DIRECT_URL=
# Opcional para migrate dev: base INDEPENDIENTE y descartable, nunca la base destino.
SHADOW_DATABASE_URL=
