# Todas las variables VITE_* son públicas y se incorporan al bundle.
VITE_API_URL=http://localhost:3000/api
# Público: true habilita datos educativos demo tras autenticación USER; false desactiva la demo.
# Sin valor: habilitado en desarrollo, deshabilitado en producción. Requiere reconstruir el build.
VITE_STUDENT_DEMO=false
# Solo tooling Vite: no se expone al navegador. Cambiar también CORS_ORIGINS.
FRONTEND_PORT=5173
