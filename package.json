{
  "name": "vocessilentes-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": "10.18.2"
  },
  "scripts": {
    "curriculum:plan": "pnpm --filter @vocessilentes/backend curriculum:plan",
    "admin:metrics:verify": "node Backend/scripts/admin-metrics-review.js",
    "lsv:prepare": "node Backend/scripts/prepare-lsv-videos.js",
    "video:verify": "pnpm --filter @vocessilentes/backend video:verify",
    "camera:verify": "pnpm --filter @vocessilentes/backend camera:verify",
    "lsv:train": "node Backend/scripts/train-lsv.js",
    "lsv:readiness": "node Backend/scripts/lsv-readiness.js",
    "lsv:train:experimental": "node Backend/scripts/train-lsv-experimental.js",
    "lsv:release:demo": "node Backend/scripts/release-lsv-demo.js",
    "lsv:demo:verify": "node Backend/scripts/lsv-demo-review.js",
    "lsv:experimental:verify": "node Backend/scripts/lsv-experimental-review.js",
    "alphabet:dev": "pnpm --filter @vocessilentes/backend alphabet:dev",
    "alphabet:verify": "pnpm --filter @vocessilentes/backend alphabet:verify",
    "learning:demo": "pnpm --filter @vocessilentes/backend learning:demo",
    "academic:prepare": "pnpm --filter @vocessilentes/backend academic:prepare",
    "academic:demo": "pnpm --filter @vocessilentes/backend academic:demo",
    "academic:verify": "pnpm --filter @vocessilentes/backend academic:verify",
    "academic:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-module-ii.ps1",
    "dev": "pnpm --parallel --filter @vocessilentes/frontend --filter @vocessilentes/backend run dev",
    "dev:frontend": "pnpm --filter @vocessilentes/frontend dev",
    "dev:backend": "pnpm --filter @vocessilentes/backend dev",
    "vercel": "vercel",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @vocessilentes/backend db:generate",
    "db:validate": "pnpm --filter @vocessilentes/backend db:validate",
    "db:migrate": "pnpm --filter @vocessilentes/backend db:migrate",
    "db:migrate:dev": "pnpm --filter @vocessilentes/backend db:migrate:dev",
    "db:status": "pnpm --filter @vocessilentes/backend db:status",
    "db:inspect": "pnpm --filter @vocessilentes/backend db:inspect",
    "db:test": "pnpm --filter @vocessilentes/backend db:test",
    "db:check": "pnpm --filter @vocessilentes/backend db:check",
    "verify": "pnpm lint && pnpm format:check && pnpm test && pnpm db:validate && pnpm build && pnpm db:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.2.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "vercel": "63.1.2"
  }
}
